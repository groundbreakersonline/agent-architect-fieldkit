{
  "name": "agent-architect-fieldkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A reference kit for the two hardest problems in enterprise voice-agent deployment: integration reliability under failure, and cross-version regression gates that actually block bad releases.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:live": "vite-node tools/live-eval.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
